{
  "name": "vizion",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "bash scripts/package.sh",
    "proxy": "node scripts/dev-proxy.mjs",
    "sim": "VITE_PROXY=http://localhost:8788/ vite build && ares-launch -s 26 ./dist -sp /Applications",
    "remote": "node server/remote-config.mjs",
    "test:remote": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.1.0",
    "@preact/signals": "^2.9.1",
    "preact": "^10.29.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
